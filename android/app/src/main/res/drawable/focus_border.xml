<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 设计指南：D-pad 焦点必须有明显、即时的视觉反馈（10-foot UI） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#2E7CF6" />
            <solid android:color="#1A2E4A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2A3440" />
            <solid android:color="#1A222C" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
