<?xml version="1.0" encoding="utf-8"?>
<!-- 频道行：Logo 为主、编号 + 频道名 + 当前节目；进度条只当前频道显示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/channel_selector">

    <!-- 频道编号 -->
    <TextView
        android:id="@+id/channel_number"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:textColor="@color/tm_text_3"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium" />

    <!-- 频道 Logo：透明PNG直接显示，无边框无底色（台标本身是视觉主体） -->
    <ImageView
        android:id="@+id/channel_logo"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="channel logo" />

    <!-- 文字区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tm_text"
            android:textSize="23sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/channel_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/tm_text_2"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 当前节目进度：仅当前播放频道显示（由 adapter 控制 visibility） -->
        <ProgressBar
            android:id="@+id/channel_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/now_playing_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="▶"
        android:textColor="@color/tm_focus"
        android:textSize="16sp"
        android:visibility="invisible" />
</LinearLayout>
