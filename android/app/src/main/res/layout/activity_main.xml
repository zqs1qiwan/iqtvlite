<?xml version="1.0" encoding="utf-8"?>
<!-- TiviMate 三栏抽屉：分组(左) | 频道列表(中) | 节目单EPG(右)，视频透出。默认全部隐藏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ① 满屏播放器（永远在底层） -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- ② 换台信息卡：台标+台名+当前节目+下一节目，右上浮出 -->
    <LinearLayout
        android:id="@+id/info_card"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/info_card_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/info_logo"
                android:layout_width="88dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:scaleType="fitCenter"
                android:contentDescription="channel logo" />
            <TextView
                android:id="@+id/info_channel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tm_focus"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/info_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_3"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/tm_text"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/info_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tm_text_2"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/info_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tm_text_2"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/info_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar" />

        <TextView
            android:id="@+id/info_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/tm_text_2"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ②b PiP 预览（焦点频道静音） -->
    <FrameLayout
        android:id="@+id/pip_container"
        android:layout_width="360dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="740dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/pip_frame"
        android:clipChildren="true"
        android:visibility="gone">
        <androidx.media3.ui.PlayerView
            android:id="@+id/pip_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:surface_type="texture_view" />
        <TextView
            android:id="@+id/pip_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="8dp"
            android:background="#B0000000"
            android:textColor="#F5F5F7"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </FrameLayout>

    <!-- ③ TiviMate 三栏抽屉：默认隐藏，半透明 -->
    <LinearLayout
        android:id="@+id/ui_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 顶栏：品牌 + 状态 + 时钟 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/panel_top_bg"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iqtv"
                android:textColor="@color/tm_text"
                android:textSize="21sp"
                android:fontFamily="sans-serif-black" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lite"
                android:textColor="@color/tm_focus"
                android:textSize="21sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginEnd="28dp" />
            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textColor="@color/tm_text_2"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/top_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/tm_text"
                android:text="--:--" />
        </LinearLayout>

        <!-- 左侧抽屉容器：宽度由代码按层级设置，右侧视频透出 -->
        <LinearLayout
            android:id="@+id/drawer_container"
            android:layout_width="1150dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 列1：分组/收藏竖列 -->
            <LinearLayout
                android:id="@+id/channel_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/panel_side_bg">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="分组"
                    android:textColor="@color/tm_focus"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/panel_top_bg" />
                <ScrollView
                    android:id="@+id/group_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:id="@+id/group_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="6dp" />
                </ScrollView>
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                    <Spinner android:id="@+id/source_spinner" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/tab_channels" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/tab_epg" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_viewmode" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_multiview" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <Button android:id="@+id/btn_push" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <EditText android:id="@+id/search_edit" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- 列2：频道竖列（台标 + 名字 + 正在播放） -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:orientation="vertical"
                android:background="@drawable/panel_side_bg">
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channel_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:listSelector="@android:color/transparent"
                        android:scrollbars="vertical" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/poster_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clipToPadding="false" />
            </LinearLayout>

            <!-- 列3：节目竖列（当前频道的节目时间表，tivimini Programs 列） -->
            <LinearLayout
                android:id="@+id/epg_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:orientation="vertical"
                android:background="@drawable/panel_side_bg">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="节目单"
                    android:textColor="@color/tm_focus"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/panel_top_bg" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epg_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="vertical" />
                <!-- 保留旧 EPG 横网格/搜索的 id（隐藏，代码 findViewById 需要） -->
                <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
                    <EditText android:id="@+id/epg_search" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/epg_search_count" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <LinearLayout android:id="@+id/epg_ruler" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ④ 首次启动引导 -->
    <LinearLayout
        android:id="@+id/first_run_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC08090B"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iqtv lite"
            android:textColor="@color/tm_focus"
            android:textSize="40sp"
            android:fontFamily="sans-serif-black" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="按 OK 查看频道信息"
            android:textColor="@color/tm_text"
            android:textSize="22sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="← 频道/节目单    → 设置    ↑ ↓ 换台    OK 信息    数字键跳台"
            android:textColor="@color/tm_text_2"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="按任意键继续"
            android:textColor="@color/tm_text_3"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
