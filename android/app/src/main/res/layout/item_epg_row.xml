<?xml version="1.0" encoding="utf-8"?>
<!-- 每行：固定频道列（sticky 通过左侧独立 LinearLayout 实现）+ 节目时间轴。
     整个 RecyclerView 放在 HorizontalScrollView 中，所以这里 timeline 用固定总宽。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:background="@color/tm_bg">

    <!-- 频道列（宽度固定；横向滚动时会一起滚走 —— 第一版可接受） -->
    <LinearLayout
        android:layout_width="140dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/tm_surface">

        <ImageView
            android:id="@+id/epg_channel_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="channel logo" />

        <TextView
            android:id="@+id/epg_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/tm_text"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 时间轴：宽度由代码按 span 动态设置 -->
    <LinearLayout
        android:id="@+id/epg_timeline"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal" />
</LinearLayout>
