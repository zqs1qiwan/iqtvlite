<?xml version="1.0" encoding="utf-8"?>
<!-- 配色对齐 tivimini / TiviMate：极简灰阶 + 唯一青蓝强调色，避免自创颜色导致混乱 -->
<resources>
    <!-- 背景层级：近黑 → 面板灰（tivimini: #121212 / #1E1E1E） -->
    <color name="tm_bg">#FF121212</color>
    <color name="tm_surface">#E61E1E1E</color>
    <color name="tm_surface_2">#E6242424</color>
    <color name="tm_panel">#E81E1E1E</color>

    <!-- 唯一强调色：青蓝（tivimini 当前节目高亮 #40C4FF） -->
    <color name="tm_focus">#FF40C4FF</color>
    <color name="tm_focus_bg">#3340C4FF</color>
    <color name="tm_accent">#FF40C4FF</color>

    <!-- 文字：白 / 浅灰 / 灰 -->
    <color name="tm_text">#FFFFFFFF</color>
    <color name="tm_text_2">#FFB3B3B3</color>
    <color name="tm_text_3">#FF757575</color>

    <!-- 进度条 -->
    <color name="tm_progress">#FF40C4FF</color>
    <color name="tm_progress_bg">#FF3A3A3C</color>
    <color name="focus_bg">#FF3A3A3C</color>
</resources>
