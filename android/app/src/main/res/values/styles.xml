<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 用 AppCompat 而非 MaterialComponents：避免 Material 自动给 Button 加蓝色 backgroundTint，
         我们要完全自定义 TV 焦点 drawable -->
    <style name="IqtvTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/tm_bg</item>
        <item name="android:colorBackground">@color/tm_bg</item>
        <item name="android:textColorPrimary">@color/tm_text</item>
        <item name="android:textColorSecondary">@color/tm_text_2</item>
        <item name="colorPrimary">@color/tm_focus</item>
        <item name="colorAccent">@color/tm_focus</item>
        <item name="android:colorAccent">@color/tm_focus</item>
        <item name="colorControlHighlight">#22FFFFFF</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:buttonStyle">@style/TvButton</item>
        <!-- 所有对话框用深色主题，避免刺眼白底破坏影院视觉 -->
        <item name="alertDialogTheme">@style/IqtvDialogTheme</item>
        <item name="android:alertDialogTheme">@style/IqtvDialogTheme</item>
    </style>

    <!-- 深色对话框（频道菜单/家长控制/确认框） -->
    <style name="IqtvDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/tm_surface_2</item>
        <item name="android:textColorPrimary">@color/tm_text</item>
        <item name="android:textColorSecondary">@color/tm_text_2</item>
        <item name="colorAccent">@color/tm_focus</item>
        <item name="android:colorAccent">@color/tm_focus</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>

    <!-- TiviMate 风格 TV 按钮：大尺寸、圆角、D-pad 焦点蓝色描边 -->
    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/focus_border</item>
        <item name="android:textColor">@color/tm_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
