<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="IqtvTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">#0C1116</item>
        <item name="android:colorBackground">#0C1116</item>
        <item name="android:textColorPrimary">#E8EDF2</item>
        <item name="android:textColorSecondary">#9AA7B4</item>
        <item name="colorPrimary">#2E7CF6</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!-- TV 按钮：大尺寸 + D-pad 焦点边框（Android TV 设计指南） -->
        <item name="android:buttonStyle">@style/TvButton</item>
    </style>

    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/focus_border</item>
        <item name="android:textColor">#E8EDF2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">80dp</item>
    </style>
</resources>
