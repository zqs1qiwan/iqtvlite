<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS 海报卡焦点效果：聚焦放大 15% + 抬升阴影（接近 Apple TV 图标 ~23% 缩放） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.15" android:duration="160" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.15" android:duration="160" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="16dp" android:duration="160" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="160" />
        </set>
    </item>
</selector>
