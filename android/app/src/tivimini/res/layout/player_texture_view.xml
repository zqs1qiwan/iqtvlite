<?xml version="1.0" encoding="utf-8"?>
<!--
  Video host for PlayerActivity. surface_type=texture_view is required:
  a SurfaceView renders into a separate compositor layer (observed at z=-2 with a 1x1 buffer)
  that sits BEHIND the Compose window, so the video is hidden (grey) until the window is removed
  on exit. A TextureView is drawn inside the normal view hierarchy, so it composites correctly
  under the Compose UI overlays (drawers/banners) and is always visible.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never" />
